# ---- backend (backend/.env or exported in your shell) ----
CATALOG_FILE=data/catalog.json        # source catalog (read-only)
QUOTES_FILE=data/quotes.json          # where saved quotes are persisted
CORS_ORIGINS=http://localhost:3000    # comma-separated list of allowed frontend origins

# ---- frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- auth ----
AUTH_SECRET=change-me-to-a-long-random-string   # signs login tokens; set a real value in production
USERS_FILE=data/users.json
